# Supabase (https://supabase.com/dashboard → Project Settings → API)
# Public URL — safe for the browser if you add a client later.
NEXT_PUBLIC_SUPABASE_URL=

# Service role — server only. Never expose in client code or commit real values.
# Used by Route Handlers (community_signups, par_q_submissions, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# No-reply From (verified domain), e.g. "Nonso Biose <noreply@yourdomain.com>"
RESEND_NOREPLY_FROM=
# Legacy: if set without RESEND_NOREPLY_FROM, used as From
# RESEND_FROM=

# Coach marketing stats (landing + GET /api/coach-marketing-stats fallback)
# UUID of the coach row used for public metrics.
COACH_MARKETING_COACH_ID=

# Optional: use remote API instead of querying Supabase from this app.
# Example: https://api.notathletes.com
# POSTs { coachId } to {base}/coach-marketing-stats
# COACH_MARKETING_STATS_API_BASE=

# Google Analytics 4 (Admin → Data streams → Web → Measurement ID, format G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
